# Bundled engine binaries (large, static, not source)
# Globbed rather than listed version-by-version: the 4.3 -> 4.7.1 upgrade
# otherwise leaves the new pair untracked-but-not-ignored, and they are ~179MB
# each, so a stray `git add -A` commits them.
Godot_v*-stable_win64*.exe
prototype/Godot_v*-stable_win64.exe
prototype/Godot_v*-stable_win64_console.exe
prototype/godot.exe
prototype/godot.zip
prototype/UPBGE-0.30-windows-x86_64/

# Godot editor cache (regenerable; import artifacts committed separately when needed)
prototype/.godot/

# Transient
prototype/log.txt
prototype/test_output.txt
prototype/compile_check_*.txt

# Visual regression: baselines/ is the checked-in reference set; captures/
# is regenerated fresh every run and would just be diff noise.
prototype/visual_regression/captures/

# Stable repo-local scratchpad for tools/blender rebuilds + Godot reimport.
# Reimport assets into an isolated copy here, then copy artifacts back into
# the real project. Persistent on purpose - see scratch/reimport_assets.sh.
prototype/scratch/.reimport_root/

# Local tool installations (Godot engine binary, future tool copies) -
# not project source, just convenient to keep next to project.godot so
# headless test runs don't have to re-find a Godot install elsewhere.
prototype/.tools/

# Local tool config (not project source)
.antigravitycli/
.claude/
.worktrees/
.agents/
skills-lock.json

# Python bytecode
__pycache__/

# Dev screenshots. Every capture_*.gd writes into res://progress_captures and
# nothing ever reads back out, so these are write-only output, not assets -
# export_presets.cfg has always excluded them from builds. They were tracked
# anyway and grew to 184MB, 46% of the whole tracked repo. Kept on disk so the
# capture history stays browsable locally.
progress_captures/
prototype/progress_captures/

# TripoSG input photos - the images that were fed to image-to-3D to produce
# assets/models/parts/*.glb. Pipeline intermediates, superseded by the
# procedural authoring in tools/blender/, and the four Python tools that read
# them hardcode a checkout path that no longer exists.
prototype/assets/temp_images/

# One-shot diagnostic probes and their screenshot output. Nothing outside
# scratch/ references any of it; each file is run by hand once
# (godot --headless --script scratch/<x>.gd) and then superseded. The three
# exceptions below are real inputs, not output: flow_source/ and flow_terrain/
# are the Flow-generated source plates that tools/process_flow_*.gd read to
# regenerate assets/textures/{hull,terrain}, fonts_download/ is the
# original download of the Special Elite font credited in CREDITS.md, and
# reimport_assets.sh is live infrastructure.
# NOTE: the ten {faction}.jpg plates still in flow_source/ are the inputs to
# the pre-livery per-faction bake and no longer feed anything - the hull side
# of that pipeline now wants ONE neutral plate (flow_source/hull_surface.jpg).
prototype/scratch/*
!prototype/scratch/flow_source/
!prototype/scratch/flow_terrain/
!prototype/scratch/fonts_download/
!prototype/scratch/reimport_assets.sh

# UI mockups and art reference that live outside the Godot project entirely -
# no .gd/.tscn/.tres references any of them.
ui_mockup/
ui_mockup_v2/
ui_assets_moodboard/

# Godot MCP bridge - a local editor addon, not project source, and not enabled
# in project.godot. Was previously neither tracked nor ignored, so it showed as
# untracked noise in every `git status`.
prototype/addons/godot_mcp_server/

# Exported builds (regenerable via `godot --export-release`, not source) -
# export_presets.cfg itself IS tracked, so any export stays reproducible.
/builds/

# Pre-rebuild copies of the bloated Tripo building GLBs (134MB of dead
# marching-cubes output, replaced by tools/blender/build_buildings.py).
# Kept on disk as a safety net because the originals were never tracked,
# but never committed - they would bloat history permanently.
_mesh_backups/

# Downloaded export template archives. Same category as the bundled engine
# binaries above: engine artifacts, not project source. The win64 pack alone is
# 1.2GB, well past GitHub's 100MB per-file hard limit.
export_templates*.tpz
export_templates*.zip
prototype/export_templates*.tpz
prototype/export_templates*.zip
.hilo/

# Music source (license holds, never tracked - CREDITS.md music licensing is a
# release blocker; keeping the .mp3s out of git history is the whole point) and
# old per-platform build outputs from prior export runs. Both kept on disk but
# not source.
Tracks/
old_builds/

# One-off test scratch and reimport logs. Ad-hoc probes dump output to
# prototype/test_<verb>_<noun>.<ext> and prototype/<thing>_test_output.txt; the
# no-op stub scripts (header literally says "kept as a no-op so the file path
# is stable") and the Godot reimport log are write-only too. Prevent future
# re-occurrences so a stray `git add -A` doesn't re-commit them.
prototype/test_run_*.txt
prototype/test_full_*.txt
prototype/test_chase_*.txt
prototype/hq_test_output.txt
prototype/test_test_range_launch.gd
prototype/test_chase_wiring.gd
prototype/test_loader.gd
prototype/.godot_reimport.log

# One-off refactor/rewrite tooling that ends up at the prototype/ root during
# big code-movement sessions. The split_*/fix_*/extract_*/test_out.txt names
# match the per-commit tool patterns left behind when a monolith is being
# carved up by ad-hoc Python / PowerShell; once the split is in, the tool is
# useless, but it lingers in the working tree because the agent that ran it
# moved on without cleaning up.
prototype/fix_*.ps1
prototype/split*.py
prototype/extract*.py
prototype/test_out.txt

# scratch/probe_axes/_* are the same category at the top-level scratch dir
# (unrelated to prototype/scratch/): one-shot probe scripts with a leading
# underscore and the throwaway GLBs they generate, vs. the pr1_* / pr2_*
# scripts that ARE part of the recorded hull-axes refactor.
scratch/probe_axes/_*.py
scratch/probe_axes/_*.glb

# Staging directory for files that have been removed from their original
# location but are kept on disk for the user to confirm before final delete.
# The dir name is timestamped so multiple cleanups don't collide. Not
# intended to live long - once the user eyeballs the contents, the dir
# can be removed wholesale.
__cleanup_trash_*/

# Agent tooling output (graphify knowledge graph, scratch probes, commit plans).
# graphify-out/ is regenerated by every run; the scratch/ scripts are one-shot.
graphify-out/
scratch/
commit_*.txt

# Playtest artifacts — screenshots and stdout/stderr from ad-hoc runs.
prototype/playtest*
prototype/probe_*
prototype/parse_check.*
prototype/smoke.*
prototype/run_*.log
prototype/run_*.err
prototype/smoke.*

# Local_Agent/ is the runtime data dir for one of the agent harnesses
# running on this machine (config, hooks, cron state, scratch memory).
# Not project source; same category as .hilo/ and .claude/ above. The
# capitalization is the literal on-disk name (case-sensitive on Linux
# CI), so the pattern has to match it.
Local_Agent/

# refactor-session scratch
_refactor_logs/
prototype/err*.txt
prototype/out*.txt
prototype/stdout.txt
prototype/stderr.txt
*~RF*.TMP
*.TMP
twin_streams_crude.png

# One-off dev-scratch from the 2026-08 map/visual sessions: ad-hoc capture
# probes, normal/team-check scripts, armor-save + heightmap probes, the 34MB
# screenshot review folder, and the orphaned spawns-tool uid. Each is a hand-
# run-one-time tool superseded by tools/ probes; kept on disk, never committed.
prototype/_cap_log.txt
prototype/_capture_*.gd*
prototype/_check_*.gd*
prototype/_probe_*.gd*
prototype/_test_new_maps.gd*
prototype/_test_spawns_tool.gd*
prototype/_visual_review/
.superpowers/
