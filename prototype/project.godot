; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Kitbash Command Prototype"
config/version="1.6.5"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WindowFit="*res://scripts/window_fit.gd"
SceneRouter="*res://scripts/scene_router.gd"
TwoPhaseTutorialManager="*res://scripts/tutorial_two_phase/two_phase_tutorial_manager.gd"
MatchConfig="*res://scripts/match_config.gd"
OperationsManager="*res://scripts/operations_manager.gd"
DebugSettings="*res://scripts/debug_settings.gd"
CursorManager="*res://scripts/cursor_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
SettingsService="*res://scripts/core/settings_service.gd"
InputService="*res://scripts/core/input_service.gd"
SystemLayer="*res://scripts/ui/system_layer.gd"
DesignRecord="*res://scripts/design_record.gd"
CommandRegistry="*res://scripts/battle/orders/command_registry.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://godot_master.log"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://resources/bomber_theme.tres"

[rendering]

textures/vram_compression/import_etc2_astc=true
# 4.7: `use_taa` overrides `screen_space_aa` when both are set (TAA is the
# primary AA; FXAA on top would double the cost for no visible quality
# gain at the 1080p target res). Battle.tscn:114-119's comment about
# `anti_aliasing/quality/screen_space_aa` is historical; the line was
# removed 2026-08-29 when this section was re-checked against the
# 4.7.1 release notes.
anti_aliasing/quality/use_taa=true
