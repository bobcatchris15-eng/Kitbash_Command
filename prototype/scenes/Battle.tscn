[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/battle/match_director.gd" id="1_director"]
[ext_resource type="Script" path="res://scripts/rts_camera.gd" id="2_rtscam"]
[ext_resource type="Script" path="res://scripts/chase_camera.gd" id="3_chasecam"]
[ext_resource type="Script" path="res://scripts/light_cap.gd" id="4_lightcap"]


[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_bt"]
; VISUAL polish 2026-08-23: sky_horizon lifted to 0.62 and sky_curve widened
; 0.12 -> 0.20 so the horizon gradient sits softer and meets the volumetric
; fog without a hard seam. Reads as "thick air" instead of "shader on a box".
sky_top_color = Color(0.40, 0.48, 0.55, 1)
sky_horizon_color = Color(0.68, 0.66, 0.60, 1)
sky_curve = 0.20
ground_bottom_color = Color(0.16, 0.18, 0.17, 1)
ground_horizon_color = Color(0.46, 0.48, 0.48, 1)
ground_curve = 0.14
sun_angle_max = 30.0

[sub_resource type="Sky" id="Sky_bt"]
sky_material = SubResource("ProceduralSkyMaterial_bt")

[sub_resource type="CameraAttributesPractical" id="CameraAttributesPractical_bt"]
; TW camera: auto-exposure disabled — the wider zoom range (8-200m)
; causes wild exposure swings that wash out the scene at distance.
; Fixed exposure gives consistent reads at all zoom levels.
auto_exposure_enabled = false
; VISUAL polish 2026-08-23 (later same day): DOF re-DISABLED. The
; re-enabled tilt-shift (distance 200, transition 80) and the follow-up
; lightened version (distance height+150, transition lerp 3..12) both
; read as "ground past the units is mush" at tactical zoom and worse,
; the soft band sits on the rocky/grassland variant boundaries and turns
; what should be a real heightmap into a tilt-shift diorama. Dropped
; the whole thing - the rts_camera.gd:75-84 zoom updates become no-ops
; while this is false. If reintroduced later, the zoom-driven formulas
; in rts_camera.gd:75-94 still drive distance/transition per zoom.
dof_blur_far_enabled = false
dof_blur_far_distance = 200.0
dof_blur_far_transition = 80.0

[sub_resource type="Environment" id="Environment_bt"]
background_mode = 2
sky = SubResource("Sky_bt")
tonemap_mode = 4
tonemap_exposure = 0.9
; 2026-08-31: ambient_light_source WAS 2, and the comment this replaces
; described 2 as "sky-aware". It is not. In Godot 4 the enum is
; BG=0 / DISABLED=1 / COLOR=2 / SKY=3, so source 2 is a FLAT COLOUR and the
; intent recorded in that comment was never actually in effect.
;
; The consequence was not just flat ambient diffuse. With no sky as an
; ambient source there is no environment specular either, so every metallic
; surface in the battle had nothing to reflect - and hull_material_builder.gd
; authors hardened_steel at metallic 0.65 / roughness 0.42. A metal with no
; reflection source has no diffuse AND no specular: it renders as dead flat
; grey. That is why nothing in a battle read as metal, across the whole
; 127-hull roster and every building, and it is why pushing contrast and
; bloom in earlier passes never fixed it.
;
; Source 3 (SKY) costs nothing extra here - the procedural sky is already
; built and already being rasterised for the background.
;
; sky_contribution is 0.7 rather than the default 1.0 deliberately. 13 of the
; 22 maps in data/maps set their own `ambient_light_color` (per-map palette;
; see map_catalog.gd's FIELD_SPEC and the override at
; match_director.gd:895), and at contribution 1.0 the sky replaces ambient
; diffuse entirely and that per-map tint goes inert. At 0.7 the sky carries
; the environment specular and most of the fill, while a map's own colour
; still tints the remaining 30% - so neither intent is lost.
;
; ambient_light_energy is overwritten at runtime by
; match_director._scale_lighting_to_world (0.75, or the map's own value); the
; value here only applies to a direct load of this scene outside a match.
ambient_light_source = 3
ambient_light_sky_contribution = 0.7
ambient_light_color = Color(0.45, 0.50, 0.55, 1)
ambient_light_energy = 0.85
ambient_light_sun_energy = 0.15
; VISUAL polish 2026-08-23 (later same day): SSAO + bloom REVERTED to
; PR-1 / pre-session values. The widened SSAO (0.8/1.4) and the bumped
; bloom (0.8/0.05) were the env-stack changes that made the rocky and
; grassland normal maps (both have R range 200+) read as "bad
; cobblestone" - the wider SSAO darkens the gap between every stone,
; the bloom halos the bright peaks, and the contrast grade (also from
; this session, retained) accentuates the difference. The volumetric
; fog and auto-exposure are kept (those are what addressed the original
; "too bright and crisp" complaint and don't amplify surface bumps).
; SKIRMISH_PERF_TROUBLESHOOTING.md PR-1. SSAO halved (radius 0.8->0.5,
; intensity 1.8->1.0) — re-applied 2026-08-23.
ssao_enabled = true
ssao_radius = 0.5
ssao_intensity = 1.0
glow_enabled = true
glow_intensity = 0.4
glow_bloom = 0.04
; SKIRMISH_PERF_TROUBLESHOOTING.md PR-1. SDFGI off — the heaviest single
; feature in this file, ~25% of frame time on a populated map at 1920x1080
; (per perf_hud.gd's 31% headline divided by the SSAO+SSIL share). Macro-bounce
; GI on a tactical RTS zoom is not visible; the sky-aware ambient above
; carries the read.
sdfgi_enabled = false
; SKIRMISH_PERF_TROUBLESHOOTING.md PR-1. SSIL off — picks up the micro-bounce
; detail SDFGI's voxels can't see, and SDFGI is now off. Stacking SSIL on
; top of SSAO was paying for itself at 8 rays/4 samples every fragment with
; nothing for it to add to.
ssil_enabled = false
; VISUAL polish 2026-08-23: grading 1.0/1.0 -> 1.15/1.08. Lab scenes use
; 1.18/1.06; this is a slightly more conservative grade tuned for a
; battlefield palette (less saturation lift, more contrast push). Free
; performance-wise (one final tonemap pass).
; Reduced 1.15/1.08 -> 1.05/1.02 on 2026-08-26 — the old grade was
; amplifying the already-wrong textures and making the scene harsh.
;
; 2026-08-31: back up to 1.18 contrast, and saturation DOWN to 0.94. The
; 2026-08-26 walk-back was correct at the time - pushing contrast on top of a
; 25% whole-surface emissive lift (hull_faction_material's indirect_lift, now
; 0.06) and per-map exposure of 1.4-1.8 (now ~1.0) could only make the harshness
; worse. With those two fixed there is a real dark end to push against.
;
; Saturation below 1.0 is deliberate and is the global half of the
; saturation-ratio fix: reference RTS frames run a desaturated base and spend
; chroma in a few small places. The small places are now the emissive accent
; lights (accent_emissive_* in hull_faction_material.gdshader), which are added
; AFTER tonemapping's input and are not touched by this adjustment.
adjustment_enabled = true
adjustment_saturation = 0.94
adjustment_contrast = 1.18
; VISUAL polish 2026-08-23: VOLUMETRIC FOG. The single biggest perceptual
; change in this pass - adds the "thick air" / atmospheric perspective
; that makes a scene read as photographed rather than viewport-previewed.
; Density dropped to near-zero on 2026-08-26 so per-map environment
; blocks (canyon_ford, twin_streams) can set their own fog without
; composing on top of a global fog that washes everything out.
; Length 250 covers the full fog depth without the 64m default cutting
; off behind the camera. Albedo integration off (gi_inject=0,
; ambient_inject=0) because the sky-aware ambient already does the read.
; 2026-08-31: depth fog in the base scene. match_director
; ._scale_lighting_to_world overrides all of these per-map (and now defaults
; them ON for every map - see FOG_AERIAL_DEFAULT there); these values exist so
; a direct load of this scene, e.g. tools/capture_battle_look.gd or the editor,
; shows the same air a match does instead of a vacuum.
fog_enabled = true
fog_density = 0.0007
fog_aerial_perspective = 0.6
fog_sky_affect = 0.3
fog_height_density = 0.01
fog_sun_scatter = 0.15
volumetric_fog_enabled = true
volumetric_fog_density = 0.0003
volumetric_fog_length = 250.0
volumetric_fog_detail_spread = 2.0
volumetric_fog_gi_inject = 0.0
volumetric_fog_ambient_inject = 0.0
volumetric_fog_sky_affect = 0.4
volumetric_fog_height = 0.0
volumetric_fog_height_density = 0.0
; VISUAL polish 2026-08-23: screen-space AA. In Godot 4.7, `screen_space_aa`
; lives on the Viewport, not the Environment, so it's set at the project
; level in prototype/project.godot's [rendering] section (see
; `anti_aliasing/quality/screen_space_aa = 1`). FXAA is a ~0.3 ms pass
; and removes the silhouette aliasing that was making edges read "crisp"
; in the wrong way.

; VISUAL polish 2026-08-23: ground safety-net material. The actual battlefield
; surface is built by terrain_builder.gd on top of this BoxMesh, so under
; normal play this BoxMesh is hidden. But if a player zooms out past a map's
; edge (rts_camera.gd max_height = 160, map half-extent up to ~300+ under
; world_scale), the box becomes visible against the fog/horizon. Default
; StandardMaterial3D on a MeshInstance3D is white (255,255,255) with no
; roughness, which was reading as a "white reflector panel" past the map.
; This neutral dark warm-grey PBR material matches the terrain palette so
; the safety net doesn't pop.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ground"]
albedo_color = Color(0.32, 0.30, 0.28, 1)
roughness = 0.85
metallic = 0.0
metallic_specular = 0.5

[sub_resource type="BoxShape3D" id="BoxShape3D_ground"]
size = Vector3(1200, 1, 1200)

[sub_resource type="BoxMesh" id="BoxMesh_ground"]
size = Vector3(1200, 1, 1200)

[node name="Battle" type="Node3D"]
script = ExtResource("1_director")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_bt")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.75, -0.433013, 0.5, 0.216506, 0.642788, 0.735077, -0.625, 0.631853, -0.453154, 0, 25, 0)
shadow_enabled = true
shadow_bias = 0.04
shadow_normal_bias = 0.8
shadow_blur = 1.0
light_color = Color(1, 0.97, 0.90, 1)
light_energy = 0.7
; 2026-08-31: light_angular_distance WAS 5.0. The real sun subtends ~0.53
; degrees; 5.0 is ten times that, and the property drives both the shadow
; penumbra and the width of the specular lobe. At 5.0 every highlight is
; smeared flat and every shadow edge is mush, so even once the environment
; had something to reflect (see ambient_light_source above) no surface could
; produce a legible highlight. 1.0 keeps a soft, slightly-hazy sun without
; dissolving the specular.
light_angular_distance = 1.0
; sun_energy is overwritten at runtime by match_director._scale_lighting_to_world
; (1.35, or the map's own `sun_energy`); the 0.7 above only applies to a
; direct load of this scene outside a match.

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.707107, 0.707107, 0, -0.707107, 0.707107, 0, 26, 26)
attributes = SubResource("CameraAttributesPractical_bt")
script = ExtResource("2_rtscam")
current = true
; (TAA is enabled project-wide in prototype/project.godot's [rendering]
; section — see anti_aliasing/quality/use_taa. In Godot 4.7 use_taa was
; moved off Camera3D onto the Viewport/project setting; setting it here
; is silently dropped at load.)

[node name="ChaseCamera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 7, 14)
script = ExtResource("3_chasecam")
current = false
; (TAA project-wide, see note on the main Camera3D above. Setting it here
; in Godot 4.7 is silently dropped because use_taa is no longer a
; Camera3D property.)

[node name="Ground" type="StaticBody3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="Ground"]
shape = SubResource("BoxShape3D_ground")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Ground"]
mesh = SubResource("BoxMesh_ground")
material_override = SubResource("StandardMaterial3D_ground")

[node name="LightCap" type="Node" parent="."]
script = ExtResource("4_lightcap")
