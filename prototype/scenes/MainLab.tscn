[sub_resource type="CameraAttributesPractical" id="CameraAttributesPractical_lab"]
; Placeholder values; designer_camera.gd rewrites dof_blur_far_distance
; on every zoom event to track the model's distance from the camera.
; dof_blur_amount is the heavy "kill the floor" setting - higher than
; Battle's 0.06 because here the floor IS the subject to be blurred,
; not just a distant landscape band.
dof_blur_far_distance = 20.0
dof_blur_far_transition = 3.0
dof_blur_amount = 0.25

